<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Version>0.2.0</Version>
    <Authors>Hibira</Authors>
    <Company>Hibira</Company>
    <Copyright>Copyright (c) 2026 Hibira</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://hibira.io</PackageProjectUrl>
    <RepositoryUrl>https://github.com/hibira-io/dotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>hibira;realtime;websocket;pusher;signalr;aspnetcore;blazor</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
</Project>
